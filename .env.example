# ---------- Public (safe to expose; these are identifiers, not secrets) ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# reCAPTCHA v3 site key used by Firebase App Check (free)
NEXT_PUBLIC_APPCHECK_SITE_KEY=

# ---------- SERVER ONLY (set in Vercel project settings, never commit) ----------
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Keep the \n escapes; the code converts them back to newlines
FIREBASE_ADMIN_PRIVATE_KEY=

# Development only. Ignored when NODE_ENV=production.
# Shows the admin layout without authentication so you can review the UI.
ADMIN_UI_PREVIEW=false
